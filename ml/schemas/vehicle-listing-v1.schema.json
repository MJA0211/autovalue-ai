{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autovalue-ai.local/schemas/vehicle-listing-v1.schema.json",
  "title": "AutoValue AI Vehicle Listing Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "source_listing_id",
    "canonical_url",
    "observed_at",
    "market_country",
    "year",
    "make",
    "model",
    "trim",
    "mileage",
    "mileage_unit",
    "condition",
    "vehicle_status",
    "engine",
    "drivetrain",
    "accident_status",
    "accident_count",
    "owner_count",
    "vehicle_type",
    "price_cents",
    "currency",
    "price_kind",
    "sale_status",
    "raw_content_sha256",
    "parser_version",
    "normalization_version",
    "ingestion_run_id",
    "authorization_policy_id"
  ],
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "source_listing_id": {"type": "string", "minLength": 1},
    "canonical_url": {"type": "string", "format": "uri"},
    "observed_at": {"type": "string", "format": "date-time"},
    "market_country": {"const": "US"},
    "year": {"type": "integer", "minimum": 1886},
    "make": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "trim": {"type": ["string", "null"]},
    "mileage": {"type": ["integer", "null"], "minimum": 0},
    "mileage_unit": {"const": "miles"},
    "condition": {"type": ["string", "null"]},
    "vehicle_status": {
      "enum": ["new", "used", "certified", null]
    },
    "engine": {"type": ["string", "null"]},
    "drivetrain": {"type": ["string", "null"]},
    "accident_status": {"type": ["string", "null"]},
    "accident_count": {"type": ["integer", "null"], "minimum": 0},
    "owner_count": {"type": ["integer", "null"], "minimum": 0},
    "vehicle_type": {"type": ["string", "null"]},
    "price_cents": {"type": "integer", "minimum": 1},
    "currency": {"const": "USD"},
    "price_kind": {
      "enum": [
        "asking",
        "completed_sale",
        "current_bid",
        "high_bid",
        "reserve",
        "monthly_payment",
        "unknown"
      ]
    },
    "sale_status": {"type": "string", "minLength": 1},
    "raw_content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parser_version": {"type": "string", "minLength": 1},
    "normalization_version": {"type": "string", "minLength": 1},
    "ingestion_run_id": {"type": "string", "minLength": 1},
    "authorization_policy_id": {"type": "string", "minLength": 1}
  }
}
