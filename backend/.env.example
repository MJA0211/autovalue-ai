# Safe development defaults. Production must replace the environment and CORS
# values; production startup rejects localhost, wildcard, and non-HTTPS origins.
AUTOVALUE_ENVIRONMENT=development
AUTOVALUE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
AUTOVALUE_TRUSTED_MODELS_ROOT=models
AUTOVALUE_MODEL_BUNDLE_DIR=models/retail-rf05-v1
AUTOVALUE_TRUSTED_CALIBRATION_ROOT=docs/experiments
AUTOVALUE_CALIBRATION_ARTIFACT_PATH=docs/experiments/retail-rf05-calibration-v1.artifact.json
AUTOVALUE_PREDICTION_HISTORY_PATH=data/local/prediction-history.sqlite3
